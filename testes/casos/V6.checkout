// Valores ilustrativos: não são dados de viagem verificados.
viagem "Europa 2027" {
  moeda EUR;             // moeda de referência do roteiro
  orcamento 2500.00 EUR; // limite para custos de deslocamento
  cidade "Lisboa" {
    chegada 2028-02-29;
    saida 2028-03-02;
  }
  cidade "Madri" {
    chegada 2028-03-02;
    saida 2028-03-04;
  }
  trecho "Lisboa" -> "Madri" {
    transporte trem;
    custo 45.50 EUR;
    duracao 2h45; // 2 h 45 min = 165 minutos
  }
}
